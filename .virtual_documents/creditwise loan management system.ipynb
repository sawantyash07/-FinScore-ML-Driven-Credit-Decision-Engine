import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from sklearn.preprocessing import LabelEncoder

# 1. Load the dataset
df = pd.read_csv('loan_approval_data.csv')

# 2. Preprocessing
# Drop non-predictive columns like ID
if 'Applicant_ID' in df.columns:
    df = df.drop(columns=['Applicant_ID'])

# Fill missing values: Median for numeric, Mode for categorical
for col in df.select_dtypes(include=['number']).columns:
    df[col] = df[col].fillna(df[col].median())

for col in df.select_dtypes(include=['object']).columns:
    df[col] = df[col].fillna(df[col].mode()[0])

# 3. Encode Categorical Columns to Numeric
# (Correlation requires numerical input)
le = LabelEncoder()
for col in df.select_dtypes(include=['object']).columns:
    df[col] = le.fit_transform(df[col])

# 4. Calculate Correlation Matrix
corr_matrix = df.corr()

# 5. Filter correlation for 'Loan_Approved' only
# Sorting to see the strongest relationships at the top
target_corr = corr_matrix[['Loan_Approved']].sort_values(by='Loan_Approved', ascending=False)

# 6. Plot the Heatmap
plt.figure(figsize=(8, 10))
sns.heatmap(target_corr, annot=True, cmap='RdBu_r', center=0, fmt=".2f")
plt.title('Correlation of Features with Loan Approval')
plt.savefig('loan_correlation_heatmap.png')


import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from sklearn.preprocessing import LabelEncoder

# 1. Load the dataset
df = pd.read_csv('loan_approval_data.csv')

# 2. Preprocessing
# Drop unique identifier columns which don't provide useful correlation
if 'Applicant_ID' in df.columns:
    df = df.drop(columns=['Applicant_ID'])

# Fill missing values: Median for numerical and Mode for categorical
for col in df.columns:
    if df[col].dtype == 'object':
        df[col] = df[col].fillna(df[col].mode()[0])
    else:
        df[col] = df[col].fillna(df[col].median())

# 3. Label Encode all categorical columns to convert them to numeric
le = LabelEncoder()
for col in df.select_dtypes(include=['object']).columns:
    df[col] = le.fit_transform(df[col])

# 4. Calculate the full correlation matrix
corr_matrix = df.corr()

# 5. Plotting the Full Heatmap
plt.figure(figsize=(16, 12))  # Large size to ensure readability
sns.heatmap(
    corr_matrix, 
    annot=True,       # Show correlation values in cells
    cmap='coolwarm',  # Color palette: Red (positive), Blue (negative)
    fmt=".2f",        # Decimal precision
    linewidths=0.5,   # Spacing between cells
    square=True       # Keep cells perfectly square
)

plt.title('Full Correlation Heatmap of All Features', fontsize=18)
plt.tight_layout()
plt.savefig('full_correlation_heatmap.png')





